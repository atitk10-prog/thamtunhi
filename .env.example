# AUTH_SECRET: Khóa bí mật ký phiên HMAC-SHA256 (BẮT BUỘC trên Production, tối thiểu 32 ký tự).
# Hệ thống cũng hỗ trợ tương thích ngược qua alias: SESSION_SECRET hoặc JWT_SECRET.
AUTH_SECRET="YOUR_SECURE_AUTH_SECRET_MIN_32_CHARS"

# GEMINI_API_KEY: Khóa Google Gemini API cho tính năng AI trợ lý soạn giáo án.
# Để trống nếu chưa dùng AI; hệ thống vẫn hoạt động bình thường và đánh dấu BLOCKED cho tính năng AI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Cấu hình Cloud Firestore Named Database
FIREBASE_PROJECT_ID="indigo-lotus-2nmq3"
FIRESTORE_DATABASE_ID="ai-studio-thmttonnh-6977e812-1e0d-459b-9789-d64af1d047b2"