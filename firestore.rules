rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'AT.IT.K10@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isTeacher() {
      return isSignedIn() && 
        (isBootstrappedAdmin() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin() || (resource.data.environmentTag == 'demo');
    }

    // Academic Years Collection
    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if true;
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // Lessons Collection
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    // Lesson Versions (Immutable Snapshots)
    match /lessonVersions/{versionId} {
      allow read: if true;
      allow write: if true;
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Attempts Collection (Student submissions & real-time auto save)
    match /attempts/{attemptId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin() || (resource.data.environmentTag == 'demo');
    }

    // Attempt Answers (Granular question interactions & misconception tracking)
    match /attemptAnswers/{answerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin() || (resource.data.environmentTag == 'demo');
    }

    // Mistake Insights Collection
    match /mistakeInsights/{insightId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable audit trail
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
